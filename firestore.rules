rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Oyuncu profilleri: herkes okuyabilir (sıralama), yalnız sahibi oluşturabilir.
    // best/lastSubmitAt YALNIZ Cloud Function (admin) yazar — istemciden değiştirilemez.
    match /players/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 40
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0
        && request.resource.data.avatar <= 9
        && request.resource.data.best == 0;
      // profil güncelleme: yalnız ülke/avatar; isim ve skor sabit
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['country', 'avatar'])
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 40
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0
        && request.resource.data.avatar <= 9;
      allow delete: if false; // silme yalnız deleteAccount fonksiyonuyla
    }
    // Ülke sıralaması: herkes okur, yalnız Cloud Function yazar.
    match /countries/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
